# Served from the assets root. Paths are absolute URL paths, so they carry the
# /hive prefix the app is deployed under.

/hive/*
  Content-Security-Policy: @CSP@
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# A cached worker script is an app that can never update. The runtime it
# imports joins the worker's stored scripts, and is compared on the same check.
/hive/sw.js
  Cache-Control: no-cache

/hive/pwa/sw-runtime.js
  Cache-Control: no-cache

# The shell is what the worker diffs to detect a deploy, so it must not be
# served stale by an intermediary.
/hive/index.html
  Cache-Control: no-cache

/hive/manifest.webmanifest
  Cache-Control: no-cache

# Content is stable for a given filename; the worker's own precache is what
# actually invalidates these, via a content hash over every shipped byte.
/hive/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/hive/icons/*
  Cache-Control: public, max-age=604800

# The worker's precache is what actually invalidates these, via a content hash
# over every shipped byte, so the filename never needs to carry one. Revalidating
# costs a conditional request and keeps a deploy from being served stale.
/hive/styles/*
  Cache-Control: no-cache

/hive/ui/*
  Cache-Control: no-cache

/hive/hive/*
  Cache-Control: no-cache

/hive/pwa/*
  Cache-Control: no-cache

/hive/vendor/*
  Cache-Control: no-cache
